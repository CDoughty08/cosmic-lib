{
  "name": "@cosmic/redis-lock",
  "version": "1.0.0",
  "description": "Distributed Redis locks using the Redlock algorithm",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
