{
  "name": "@cosmic/monorepo",
  "version": "1.0.0",
  "description": "Cosmic Redis package suite",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test -- --coverage",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "prepare": "husky",
    "bump-version": "turbo-tools version -d"
  },
  "devDependencies": {
    "@better-builds/turbo-tools": "7.4.0",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.37.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.6.2",
    "@typescript-eslint/eslint-plugin": "8.45.0",
    "@typescript-eslint/parser": "8.45.0",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "prettier": "3.6.2",
    "ts-jest": "29.4.4",
    "tsup": "8.5.0",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.18.0"
}
